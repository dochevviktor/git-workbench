{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "dev.gitworkbench.desktop",
  "productName": "Git Workbench",
  "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
  "directories": { "output": "release" },
  "files": ["out/**/*", "package.json", "LICENSE"],
  "asar": true,
  "publish": null,
  "extraResources": [
    { "from": "resources/icon.png", "to": "icon.png" },
    { "from": "node_modules/electron/dist/LICENSE", "to": "LICENSE.electron.txt" },
    { "from": "node_modules/electron/dist/LICENSES.chromium.html", "to": "LICENSES.chromium.html" }
  ],
  "npmRebuild": false,
  "appImage": { "executableArgs": [] },
  "linux": {
    "target": ["AppImage"],
    "category": "Development",
    "icon": "resources/icon.png",
    "syncDesktopName": true,
    "desktop": { "entry": { "Keywords": "Git;Version Control;Development;", "StartupNotify": "true" } }
  },
  "deb": {
    "depends": [
      "git (>= 1:2.43.0)",
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libasound2t64 | libasound2",
      "libgbm1",
      "libxkbcommon0"
    ]
  },
  "win": { "target": ["nsis"], "icon": "resources/icon.ico" },
  "mac": {
    "target": [{ "target": "dmg", "arch": ["universal"] }],
    "identity": "-",
    "hardenedRuntime": false,
    "icon": "resources/icon.png",
    "category": "public.app-category.developer-tools"
  }
}
