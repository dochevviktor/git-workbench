{
  "name": "git-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "A Linux-first Git desktop client built with Electron, React, and TypeScript",
  "author": "Viktor Dochev",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.cjs",
  "desktopName": "git-workbench.desktop",
  "engines": {
    "node": "^24.13.0",
    "npm": ">=11"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "start:dev": "npm run dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:prod": "npm run package",
    "typecheck": "npm run typecheck:common && npm run typecheck:node && npm run typecheck:renderer",
    "typecheck:common": "tsc --noEmit -p src/common/tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p src/frontend/react/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:capabilities": "node scripts/test-platform.ts",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "research:references": "node scripts/fork-references.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "package": "npm run build && electron-builder --config electron-builder.json --publish never && node scripts/release-manifest.ts",
    "package:deb": "npm run build && node scripts/package-deb.ts",
    "release:manifest": "node scripts/release-manifest.ts",
    "test:p14": "npm run test:e2e -- tests/e2e/p14-accessibility.test.ts",
    "test:package": "node scripts/verify-package.ts",
    "package:dir": "npm run build && electron-builder --config electron-builder.json --dir --publish never"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jiti": "^2.7.0",
    "prettier": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
